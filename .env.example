# Copy to .env.local and fill in. Never commit .env.local.
# Local values come from `pnpm exec supabase status -o env` after `pnpm db:start`.

# --- Browser-visible (shipped in the client bundle) ---
# Supabase API URL, e.g. http://127.0.0.1:55321 for local development.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key only (sb_publishable_...). The app refuses to start with a secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public origin of this app; used in auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server and scripts only (never prefix with NEXT_PUBLIC_) ---
# Operator secret key (sb_secret_...). Scripts and integration tests only; never web or workers.
# The web app does not read it in this stage.
SUPABASE_SECRET_KEY=

# Optional in-memory demo only. Never enabled in production.
# LOCAL_PGLITE_SANDBOX=0

# E6: separate, server-only payment backend token (provision with pnpm payments:setup).
PAYMENT_BACKEND_TOKEN=
# JSON registry: credential_ref -> webhook secret; never ship this to a browser.
# Stripe: whsec_ signing secret; RevenueCat: the configured Bearer token; Generic: HMAC secret.
PAYMENT_WEBHOOK_SECRETS_JSON={}
