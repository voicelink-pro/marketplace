{
  "name": "boostlink",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "payments:worker": "node --env-file-if-exists=.env.local scripts/payment-worker.mjs",
    "payments:setup": "node --env-file-if-exists=.env.local scripts/configure-payment-backend.mjs --local",
    "test:integration": "node scripts/test-integration.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/db-types.mjs",
    "db:advisors": "supabase db advisors --local --type all --fail-on warn",
    "admin:grant": "node --env-file-if-exists=.env.local scripts/grant-admin.mjs",
    "commissions:worker": "node --env-file-if-exists=.env.local scripts/commission-worker.mjs",
    "commissions:operator": "node --env-file-if-exists=.env.local scripts/commission-operator.mjs",
    "finance:worker": "node --env-file-if-exists=.env.local scripts/finance-worker.mjs",
    "finance:operator": "node --env-file-if-exists=.env.local scripts/finance-operator.mjs",
    "ops:check": "node --env-file-if-exists=.env.local scripts/operations-check.mjs",
    "backup:local": "node scripts/local-backup.mjs",
    "test:pilot": "node scripts/test-pilot.mjs"
  },
  "dependencies": {
    "@bprogress/next": "3.2.12",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "motion": "14.7.1",
    "next": "16.4.3",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "server-only": "0.0.1",
    "shadcn": "4.22.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "sharp": "0.35.5",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.33.4"
}
